# --- API ---
APP_NAME=Базис
APP_ENV=dev
SECRET_KEY=change-me-in-prod-please
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- PostgreSQL ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=hackauth
POSTGRES_PASSWORD=hackauth
POSTGRES_DB=hackauth

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Storage ---
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=64

# --- Judge ---
JUDGE_TIME_LIMIT_SEC=2
JUDGE_MEMORY_LIMIT_MB=128
